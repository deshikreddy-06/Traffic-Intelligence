# Backend Configuration
APP_NAME=India Traffic Intelligence
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://hyderabad-traffic-frontend-2026.onrender.com

# Database
DATABASE_URL=sqlite:///./hti_dev.db

# Google Maps API (Required for nationwide routing and places)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# External API Keys
GEOAPIFY_API_KEY=your_geoapify_api_key_here
VALHALLA_URL=https://valhalla1.openstreetmap.de/route

# ML Configuration
ML_MODEL_PATH=./ml/artifacts
PREDICTION_CONFIDENCE_THRESHOLD=0.7

# Data Ingestion
INGESTION_ENABLED=false
INGESTION_SCHEDULE=0 0 * * *  # Daily at midnight

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Docker deployment (copy this file to .env before running docker compose)
POSTGRES_USER=hti_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=hyderabad_traffic
WEB_PORT=8080
GEOAPIFY_API_KEY=your_geoapify_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_API_URL=https://your-render-backend.onrender.com/api
